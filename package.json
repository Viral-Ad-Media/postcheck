{
  "name": "vam-postcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:staging": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-staging.mjs",
    "test:auth-http": "node scripts/check-auth-http.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate-auth.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
