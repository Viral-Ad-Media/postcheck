# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/postcheck?sslmode=verify-full
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NIPOST_API_KEY=

# Verified sender and provider SMTP credentials for confirmation/recovery email.
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Comma-separated HTTPS partner origins allowed to call /api/widget.
POSTCHECK_WIDGET_ORIGINS=
